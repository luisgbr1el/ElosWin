<Page
    x:Class="ElosWin.Views.CallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ElosWin.Models">

    <Grid Padding="36,20,36,24" RowDefinitions="Auto, *, Auto">
        <!-- Cabeçalho Fixo Superior -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Chamada" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Converse e compartilhe sua tela na rede local ou VPN" FontSize="13" Opacity="0.6"/>
            </StackPanel>

            <Border Grid.Column="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="20" 
                    Padding="14,6" 
                    VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Opacity="0.9" 
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Área Central Rolável (Stream + Participantes) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                <!-- 1. Banner para quando VOCÊ está compartilhando tela (Sem janela preta) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16" 
                        Visibility="{x:Bind ViewModel.ShowLocalScreenSharingBanner, Mode=OneWay}">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="20" Width="36" Height="36">
                                <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Você está transmitindo sua tela" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Os outros participantes na chamada podem ver sua transmissão" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Command="{x:Bind ViewModel.StopScreenShareCommand}" 
                                Background="#E11D48" 
                                Foreground="White" 
                                Height="36" 
                                Padding="14,0" 
                                CornerRadius="6" 
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA14;" FontSize="13"/>
                                <TextBlock Text="Parar de compartilhar" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Transmissão Remota Ativa (Apenas exibida se você estiver na chamada e OUTRA pessoa estiver transmitindo) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14" 
                        Visibility="{x:Bind ViewModel.ShowRemoteScreenStream, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.ScreenStreamPresenterText, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Command="{x:Bind ViewModel.ToggleScreenShareFullscreenCommand}" 
                                    Visibility="{x:Bind ViewModel.CanShowScreenShareFullscreenButton, Mode=OneWay}" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Padding="8,4" 
                                    VerticalAlignment="Center" 
                                    ToolTipService.ToolTip="Modo tela cheia">
                                <FontIcon Glyph="&#xE740;" FontSize="14"/>
                            </Button>

                            <Button Grid.Column="2" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Padding="8,4" 
                                    VerticalAlignment="Center" 
                                    ToolTipService.ToolTip="Opções da transmissão">
                                <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Width="220" Spacing="12" Padding="4">
                                            <TextBlock Text="Opções da transmissão" FontWeight="SemiBold" FontSize="13"/>
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Text="Volume" FontSize="12" Opacity="0.8"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StreamVolumeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Slider Value="{x:Bind ViewModel.StreamVolume, Mode=TwoWay}" Minimum="0" Maximum="200" StepFrequency="1" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <Border CornerRadius="6" Background="Black" MinHeight="260" MaxHeight="520" HorizontalAlignment="Stretch">
                            <Image Source="{x:Bind ViewModel.RemoteScreenImage, Mode=OneWay}" Stretch="Uniform"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Participantes -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Participantes na chamada" FontSize="14" FontWeight="SemiBold"/>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                MinHeight="220">
                            <Grid>
                                <TextBlock Text="Ninguém na chamada no momento." 
                                           FontSize="13" 
                                           Opacity="0.5" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Visibility="{x:Bind ViewModel.NoParticipantsInCall, Mode=OneWay}"/>
                                <ListView ItemsSource="{x:Bind ViewModel.ConnectedParticipants}" 
                                          Visibility="{x:Bind ViewModel.HasParticipantsInCall, Mode=OneWay}" 
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PeerInfo">
                                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="8,6">
                                                <Border Grid.Column="0" 
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                                        BorderBrush="{x:Bind SpeakingBorderBrush, Mode=OneWay}" 
                                                        BorderThickness="2" 
                                                        CornerRadius="20" 
                                                        Width="40" 
                                                        Height="40" 
                                                        MinWidth="40"
                                                        MinHeight="40"
                                                        MaxWidth="40"
                                                        MaxHeight="40"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE77B;" 
                                                                  FontSize="16" 
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                                  HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,0,1"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold"/>
                                                        <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind IsSharingScreen, Mode=OneWay}" ToolTipService.ToolTip="Transmitindo tela"/>
                                                        <FontIcon Glyph="&#xE74F;" FontSize="11" Foreground="#E11D48" VerticalAlignment="Center" Visibility="{x:Bind IsLocallyMuted, Mode=OneWay}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Opacity="0.5"/>
                                                </StackPanel>

                                                <Button Grid.Column="2" 
                                                        Visibility="{x:Bind IsRemoteUser, Mode=OneWay}" 
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="8,4" 
                                                        VerticalAlignment="Center" 
                                                        ToolTipService.ToolTip="Opções do usuário">
                                                    <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                                    <Button.Flyout>
                                                        <Flyout Placement="LeftEdgeAlignedTop">
                                                            <StackPanel Width="230" Spacing="14" Padding="4">
                                                                <TextBlock Text="{x:Bind Username}" FontWeight="SemiBold" FontSize="14"/>
                                                                <StackPanel Spacing="6">
                                                                    <Grid ColumnDefinitions="*, Auto">
                                                                        <TextBlock Text="Volume da voz" FontSize="12" Opacity="0.8"/>
                                                                        <TextBlock Grid.Column="1" Text="{x:Bind UserVolumeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                                                    </Grid>
                                                                    <Slider Value="{x:Bind UserVolume, Mode=TwoWay}" Minimum="0" Maximum="200" StepFrequency="1" HorizontalAlignment="Stretch"/>
                                                                </StackPanel>
                                                                <MenuFlyoutSeparator Margin="0"/>
                                                                <ToggleSwitch Header="Silenciar" IsOn="{x:Bind IsLocallyMuted, Mode=TwoWay}" OnContent="Sim" OffContent="Não"/>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra Inferior Fixa de Ações -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="12">
            <Grid>
                <!-- Botão Iniciar / Entrar (Fora da chamada) -->
                <Button Content="{x:Bind ViewModel.MainActionButtonText, Mode=OneWay}" 
                        Command="{x:Bind ViewModel.StartOrJoinCallCommand}" 
                        Visibility="{x:Bind ViewModel.IsNotInCall, Mode=OneWay}" 
                        Style="{ThemeResource AccentButtonStyle}" 
                        Foreground="White" 
                        HorizontalAlignment="Stretch" 
                        Height="44" 
                        FontWeight="Bold" 
                        FontSize="14" 
                        CornerRadius="6"/>

                <!-- Controles em Chamada (Em chamada) -->
                <Grid ColumnDefinitions="*, 10, *, 10, *, 10, *" Visibility="{x:Bind ViewModel.IsInCall, Mode=OneWay}">
                    <Button Grid.Column="0" 
                            Command="{x:Bind ViewModel.ToggleMuteCommand}" 
                            IsEnabled="{x:Bind ViewModel.CanToggleMute, Mode=OneWay}" 
                            HorizontalAlignment="Stretch" 
                            Height="44" 
                            CornerRadius="6" 
                            ToolTipService.ToolTip="{x:Bind ViewModel.MuteToolTip, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.MuteGlyph, Mode=OneWay}" FontSize="18"/>
                    </Button>

                    <Button Grid.Column="2" 
                            Command="{x:Bind ViewModel.ToggleDeafenCommand}" 
                            HorizontalAlignment="Stretch" 
                            Height="44" 
                            CornerRadius="6" 
                            ToolTipService.ToolTip="{x:Bind ViewModel.DeafenToolTip, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.DeafenGlyph, Mode=OneWay}" FontSize="18"/>
                    </Button>

                    <Button Grid.Column="4" 
                            Click="ShareScreenButton_Click" 
                            HorizontalAlignment="Stretch" 
                            Height="44" 
                            CornerRadius="6" 
                            IsEnabled="{x:Bind ViewModel.IsInCall, Mode=OneWay}" 
                            ToolTipService.ToolTip="{x:Bind ViewModel.ScreenShareButtonToolTip, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.ScreenShareButtonGlyph, Mode=OneWay}" FontSize="18"/>
                    </Button>

                    <Button Grid.Column="6" 
                            Command="{x:Bind ViewModel.LeaveCallCommand}" 
                            Background="#E11D48" 
                            Foreground="White" 
                            HorizontalAlignment="Stretch" 
                            Height="44" 
                            CornerRadius="6" 
                            ToolTipService.ToolTip="Sair da chamada">
                        <FontIcon Glyph="&#xE778;" FontSize="18"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>