<Page
    x:Class="ElosWin.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:naudio="using:NAudio.CoreAudioApi">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="36,20,36,36">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                <StackPanel Spacing="4">
                    <TextBlock Text="Configurações" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Ajuste suas opções de voz, microfone e portas de rede" FontSize="13" Opacity="0.6"/>
                </StackPanel>

                <!-- Usuário -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Usuário" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Header="Nome de exibição" Text="{x:Bind ViewModel.Username, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- Voz e Dispositivos -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Voz e dispositivos" FontSize="15" FontWeight="SemiBold"/>

                        <StackPanel Spacing="8">
                            <ComboBox Header="Dispositivo de entrada (microfone)" ItemsSource="{x:Bind ViewModel.AvailableMicrophones}" SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="naudio:MMDevice">
                                        <TextBlock Text="{x:Bind FriendlyName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid ColumnDefinitions="Auto, *" Margin="0,2,0,0">
                                <TextBlock Text="Volume de entrada:" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider Grid.Column="1" Value="{x:Bind ViewModel.InputVolume, Mode=TwoWay}" Minimum="0" Maximum="200" StepFrequency="1" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <ComboBox Header="Dispositivo de saída (fones / alto-falantes)" ItemsSource="{x:Bind ViewModel.AvailableOutputDevices}" SelectedItem="{x:Bind ViewModel.SelectedOutputDevice, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="naudio:MMDevice">
                                        <TextBlock Text="{x:Bind FriendlyName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid ColumnDefinitions="Auto, *" Margin="0,2,0,0">
                                <TextBlock Text="Volume de saída:" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider Grid.Column="1" Value="{x:Bind ViewModel.OutputVolume, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="1" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Supressão de ruído" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Filtra ruídos de fundo e sons indesejados do microfone via IA" 
                                               FontSize="12" 
                                               Opacity="0.6" 
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.EnableNoiseSuppression, Mode=TwoWay}"
                                              MinWidth="0"
                                              OnContent="{x:Null}"
                                              OffContent="{x:Null}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Text="Sensibilidade do microfone:" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Slider Grid.Column="1" Value="{x:Bind ViewModel.GateSensitivity, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.EnableNoiseSuppression, Mode=OneWay}" Minimum="0" Maximum="100" StepFrequency="1" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Text="Intensidade do corte de ruído:" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Slider Grid.Column="1" Value="{x:Bind ViewModel.NoiseSuppressionLevel, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.EnableNoiseSuppression, Mode=OneWay}" Minimum="0" Maximum="100" StepFrequency="1" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Button Content="{x:Bind ViewModel.TestMicButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleTestMicCommand}" IsEnabled="{x:Bind ViewModel.IsNotInCall, Mode=OneWay}" HorizontalAlignment="Stretch" Height="38" CornerRadius="6"/>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Text="Nível:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0.8"/>
                                <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                                    <Border Background="#25808080" CornerRadius="3" />
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind ViewModel.VoiceFillGridLength, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind ViewModel.VoiceEmptyGridLength, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#22C55E" CornerRadius="3" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Rede -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Rede e portas" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Header="Minha porta local UDP" Text="{x:Bind ViewModel.LocalPort, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Notificações -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Notificações" FontSize="15" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Bate-papo" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Exibir notificações na área de trabalho quando receber novas mensagens" 
                                           FontSize="12" 
                                           Opacity="0.6" 
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.EnableNotifications, Mode=TwoWay}"
                                          MinWidth="0"
                                          OnContent="{x:Null}"
                                          OffContent="{x:Null}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sobre e Atualizações -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Aplicação" FontSize="15" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Elos" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Comunicação por voz peer-to-peer nativa" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>

                        <Button Content="{x:Bind ViewModel.CheckForUpdatesButtonText, Mode=OneWay}" 
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}" 
                                HorizontalAlignment="Stretch" 
                                Height="38" 
                                CornerRadius="6"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>