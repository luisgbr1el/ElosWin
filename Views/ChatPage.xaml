<Page
    x:Class="ElosWin.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ElosWin.Models">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="36,20,36,36">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch" MaxWidth="900">
                <!-- Cabeçalho -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Bate-papo" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Troque mensagens com todos na rede local" FontSize="13" Opacity="0.6"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ChatStatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Opacity="0.9" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Área de Mensagens e Envio -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <Grid RowDefinitions="*, Auto" MinHeight="480">
                        <TextBlock Grid.Row="0" Text="Nenhuma mensagem. Diga oi!" FontSize="13" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.NoChatMessages, Mode=OneWay}"/>

                        <ListView Grid.Row="0" ItemsSource="{x:Bind ViewModel.ChatMessages}" Visibility="{x:Bind ViewModel.HasChatMessages, Mode=OneWay}" SelectionMode="None" Margin="0,0,0,16">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ChatMessage">
                                    <Grid Margin="0,4" HorizontalAlignment="{x:Bind Alignment}">
                                        <Border Background="{x:Bind BubbleBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" MaxWidth="520">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Text="{x:Bind SenderName}" FontSize="12" FontWeight="Bold" Margin="0,0,12,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind TimestampText}" FontSize="10" Opacity="0.6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Content}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Grid.Row="1" ColumnDefinitions="*, 8, Auto">
                            <TextBox Grid.Column="0" PlaceholderText="Digite uma mensagem..." Text="{x:Bind ViewModel.ChatInputMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" Height="40" CornerRadius="6"/>
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.SendMessageCommand}" Style="{ThemeResource AccentButtonStyle}" Height="40" Width="46" CornerRadius="6" ToolTipService.ToolTip="Enviar mensagem">
                                <FontIcon Glyph="&#xE724;" FontSize="14" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>