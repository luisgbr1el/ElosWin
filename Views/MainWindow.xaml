<Window
    x:Class="ElosWin.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Elos">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título do App -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="Elos" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Menu Lateral e Conteúdo Principal -->
        <NavigationView 
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            IsSettingsVisible="False"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CallNavItem" Content="Chamada" Tag="Call" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE717;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ChatNavItem" Content="Bate-papo" Tag="Chat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="SettingsNavItem" Content="Configurações" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Frame onde as páginas são renderizadas -->
            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- Overlay Fullscreen para Transmissão de Tela (Sem cobrir os botões da janela) -->
        <Grid x:Name="FullscreenOverlay"
              Grid.Row="1"
              Background="#0F0F0F"
              Visibility="{x:Bind CallVm.IsScreenShareFullscreen, Mode=OneWay}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra Superior da Transmissão (Status e Apresentador) -->
            <Border Grid.Row="0" 
                    Background="#1E1E1E" 
                    BorderBrush="#2E2E2E" 
                    BorderThickness="0,0,0,1" 
                    Padding="18,10">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind CallVm.ScreenStreamPresenterText, Mode=OneWay}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13" 
                                   Foreground="#F3F3F3"/>
                    </StackPanel>

                    <Border Grid.Column="2" 
                            Background="#2A2A2A" 
                            BorderBrush="#3D3D3D" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="8,3">
                        <TextBlock Text="AO VIVO" FontSize="10" FontWeight="Bold" Foreground="#22C55E"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Área da Imagem de Transmissão -->
            <Border Grid.Row="1" Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Image Source="{x:Bind CallVm.RemoteScreenImage, Mode=OneWay}" Stretch="Uniform"/>
            </Border>

            <!-- Barra Inferior Redesenhada (Controles da chamada e áudio) -->
            <Border Grid.Row="2" 
                    Background="#181818" 
                    BorderBrush="#2E2E2E" 
                    BorderThickness="0,1,0,0" 
                    Padding="20,12">
                <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                    <!-- Controle de Volume -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="#A8A8A8" VerticalAlignment="Center"/>
                        <Slider Value="{x:Bind CallVm.StreamVolume, Mode=TwoWay}" 
                                Minimum="0" 
                                Maximum="200" 
                                StepFrequency="1" 
                                Width="140" 
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind CallVm.StreamVolumeText, Mode=OneWay}" 
                                   FontSize="12" 
                                   Foreground="#A8A8A8" 
                                   Width="38" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Separador -->
                    <Border Grid.Column="1" Width="1" Height="24" Background="#333333" Margin="18,0"/>

                    <!-- Botões Centrais de Voz e Ação -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <!-- Mutar Microfone -->
                        <Button Command="{x:Bind CallVm.ToggleMuteCommand}" 
                                IsEnabled="{x:Bind CallVm.CanToggleMute, Mode=OneWay}" 
                                Background="#2A2A2A" 
                                BorderThickness="1" 
                                BorderBrush="#3A3A3A" 
                                Width="44" 
                                Height="38" 
                                CornerRadius="6" 
                                ToolTipService.ToolTip="{x:Bind CallVm.MuteToolTip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind CallVm.MuteGlyph, Mode=OneWay}" FontSize="15" Foreground="White"/>
                        </Button>

                        <!-- Desativar Áudio Geral -->
                        <Button Command="{x:Bind CallVm.ToggleDeafenCommand}" 
                                Background="#2A2A2A" 
                                BorderThickness="1" 
                                BorderBrush="#3A3A3A" 
                                Width="44" 
                                Height="38" 
                                CornerRadius="6" 
                                ToolTipService.ToolTip="{x:Bind CallVm.DeafenToolTip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind CallVm.DeafenGlyph, Mode=OneWay}" FontSize="15" Foreground="White"/>
                        </Button>

                        <!-- Sair da Chamada -->
                        <Button Command="{x:Bind CallVm.LeaveCallCommand}" 
                                Background="#E11D48" 
                                BorderThickness="0" 
                                Width="44" 
                                Height="38" 
                                CornerRadius="6" 
                                ToolTipService.ToolTip="Sair da chamada">
                            <FontIcon Glyph="&#xE778;" FontSize="15" Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <!-- Sair da Tela Cheia -->
                    <Button Grid.Column="3" 
                            Command="{x:Bind CallVm.ToggleScreenShareFullscreenCommand}" 
                            Background="#2A2A2A" 
                            BorderThickness="1" 
                            BorderBrush="#3A3A3A" 
                            Height="38" 
                            Padding="14,0" 
                            CornerRadius="6" 
                            ToolTipService.ToolTip="Sair da tela cheia">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73F;" FontSize="13" Foreground="White"/>
                            <TextBlock Text="Sair da tela cheia" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>