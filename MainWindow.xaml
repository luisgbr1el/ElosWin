<Window
    x:Class="ElosWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ElosWin.Models"
    xmlns:naudio="using:NAudio.CoreAudioApi"
    mc:Ignorable="d"
    Title="Elos">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE717;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Elos" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Menu lateral -->
        <NavigationView 
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            IsSettingsVisible="False"
            ItemInvoked="NavView_ItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CallNavItem" Content="Chamada" Tag="Call" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE717;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="SettingsNavItem" Content="Configurações" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Área de conteúdo -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid Padding="36,20,36,36" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- ================= PÁGINA 1: CHAMADA ================= -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsCallPageVisible, Mode=OneWay}" 
                                Spacing="24" 
                                HorizontalAlignment="Stretch"
                                MaxWidth="900">

                        <!-- Cabeçalho -->
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Chamada" FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="Converse e compartilhe sua tela na rede local ou VPN" FontSize="13" Opacity="0.6"/>
                            </StackPanel>

                            <!-- Badge de status -->
                            <Border Grid.Column="1" 
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="14,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" 
                                           Opacity="0.9" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Transmissão de Tela Ativa -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Visibility="{x:Bind ViewModel.HasActiveScreenStream, Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.ScreenStreamPresenterText, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>

                                    <!-- Botão Fullscreen (apenas para não-apresentadores que estão na chamada) -->
                                    <Button Grid.Column="1"
                                            Command="{x:Bind ViewModel.ToggleScreenShareFullscreenCommand}"
                                            Visibility="{x:Bind ViewModel.CanShowScreenShareFullscreenButton, Mode=OneWay}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Modo tela cheia">
                                        <FontIcon Glyph="&#xE740;" FontSize="14"/>
                                    </Button>

                                    <!-- Menu de Opções da Transmissão (Três Pontinhos) -->
                                    <Button Grid.Column="2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Opções da transmissão">
                                        <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <StackPanel Width="220" Spacing="12" Padding="4">
                                                    <TextBlock Text="Opções da transmissão" FontWeight="SemiBold" FontSize="13"/>

                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <TextBlock Text="Volume" FontSize="12" Opacity="0.8"/>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StreamVolumeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                                        </Grid>
                                                        <Slider Value="{x:Bind ViewModel.StreamVolume, Mode=TwoWay}"
                                                                Minimum="0"
                                                                Maximum="200"
                                                                StepFrequency="1"
                                                                HorizontalAlignment="Stretch"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- Área do Player de Vídeo -->
                                <Border CornerRadius="6" Background="Black" MinHeight="260" MaxHeight="450" HorizontalAlignment="Stretch">
                                    <Image Source="{x:Bind ViewModel.RemoteScreenImage, Mode=OneWay}" Stretch="Uniform"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card de participantes -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Participantes na chamada" FontSize="14" FontWeight="SemiBold"/>

                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinHeight="180">
                                    <Grid>
                                        <TextBlock Text="Ninguém na chamada no momento." 
                                                   FontSize="13" 
                                                   Opacity="0.5" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind ViewModel.NoParticipantsInCall, Mode=OneWay}"/>

                                        <ListView ItemsSource="{x:Bind ViewModel.ConnectedParticipants}"
                                                  Visibility="{x:Bind ViewModel.HasParticipantsInCall, Mode=OneWay}"
                                                  SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:PeerInfo">
                                                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="8,6">
                                                        <Border Grid.Column="0" 
                                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{x:Bind SpeakingBorderBrush, Mode=OneWay}"
                                                                BorderThickness="2"
                                                                CornerRadius="20" 
                                                                Width="38" 
                                                                Height="38" 
                                                                Margin="0,0,12,0">
                                                            <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold"/>
                                                                <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind IsSharingScreen, Mode=OneWay}" ToolTipService.ToolTip="Transmitindo tela"/>
                                                                <FontIcon Glyph="&#xE74F;" FontSize="11" Foreground="#E11D48" VerticalAlignment="Center" Visibility="{x:Bind IsLocallyMuted, Mode=OneWay}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Opacity="0.5"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="2"
                                                                Visibility="{x:Bind IsRemoteUser, Mode=OneWay}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="8,4"
                                                                VerticalAlignment="Center"
                                                                ToolTipService.ToolTip="Opções do usuário">
                                                            <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                                            <Button.Flyout>
                                                                <Flyout Placement="LeftEdgeAlignedTop">
                                                                    <StackPanel Width="230" Spacing="14" Padding="4">
                                                                        <TextBlock Text="{x:Bind Username}" FontWeight="SemiBold" FontSize="14"/>

                                                                        <StackPanel Spacing="6">
                                                                            <Grid ColumnDefinitions="*, Auto">
                                                                                <TextBlock Text="Volume da voz" FontSize="12" Opacity="0.8"/>
                                                                                <TextBlock Grid.Column="1" Text="{x:Bind UserVolumeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                                                            </Grid>
                                                                            <Slider Value="{x:Bind UserVolume, Mode=TwoWay}"
                                                                                    Minimum="0"
                                                                                    Maximum="200"
                                                                                    StepFrequency="1"
                                                                                    HorizontalAlignment="Stretch"/>
                                                                        </StackPanel>

                                                                        <MenuFlyoutSeparator Margin="0"/>

                                                                        <ToggleSwitch Header="Silenciar"
                                                                                      IsOn="{x:Bind IsLocallyMuted, Mode=TwoWay}"
                                                                                      OnContent="Sim"
                                                                                      OffContent="Não"/>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Botão Iniciar / Entrar -->
                        <Button Content="{x:Bind ViewModel.MainActionButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.StartOrJoinCallCommand}"
                                Visibility="{x:Bind ViewModel.IsNotInCall, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Foreground="White"
                                HorizontalAlignment="Stretch"
                                Height="42"
                                FontWeight="Bold"
                                FontSize="14"
                                CornerRadius="6"/>

                        <!-- Controles em chamada -->
                        <Grid ColumnDefinitions="*, 10, *, 10, *, 10, *" Visibility="{x:Bind ViewModel.IsInCall, Mode=OneWay}">
                            <Button Grid.Column="0" 
                                    Command="{x:Bind ViewModel.ToggleMuteCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanToggleMute, Mode=OneWay}"
                                    HorizontalAlignment="Stretch"
                                    Height="46"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.MuteToolTip, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.MuteGlyph, Mode=OneWay}" FontSize="18"/>
                            </Button>

                            <Button Grid.Column="2" 
                                    Command="{x:Bind ViewModel.ToggleDeafenCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="46"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.DeafenToolTip, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.DeafenGlyph, Mode=OneWay}" FontSize="18"/>
                            </Button>

                            <!-- Botão de Compartilhar Tela -->
                            <Button Grid.Column="4" 
                                    Click="ShareScreenButton_Click"
                                    HorizontalAlignment="Stretch"
                                    Height="46"
                                    CornerRadius="6"
                                    IsEnabled="{x:Bind ViewModel.IsInCall, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.ScreenShareButtonToolTip, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.ScreenShareButtonGlyph, Mode=OneWay}" FontSize="18"/>
                            </Button>

                            <Button Grid.Column="6" 
                                    Command="{x:Bind ViewModel.LeaveCallCommand}"
                                    Background="#E11D48"
                                    Foreground="White"
                                    HorizontalAlignment="Stretch"
                                    Height="46"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="Sair da chamada">
                                <FontIcon Glyph="&#xE778;" FontSize="18"/>
                            </Button>
                        </Grid>

                    </StackPanel>

                    <!-- ================= PÁGINA 2: CONFIGURAÇÕES ================= -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsSettingsPageVisible, Mode=OneWay}" 
                                Spacing="24" 
                                HorizontalAlignment="Stretch"
                                MaxWidth="900">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Configurações" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="Ajuste suas opções de voz, microfone e portas de rede" FontSize="13" Opacity="0.6"/>
                        </StackPanel>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Usuário" FontSize="15" FontWeight="SemiBold"/>
                                <TextBox Header="Nome de exibição" 
                                         Text="{x:Bind ViewModel.Username, Mode=TwoWay}" 
                                         HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="20">
                                <TextBlock Text="Voz e dispositivos" FontSize="15" FontWeight="SemiBold"/>

                                <StackPanel Spacing="8">
                                    <ComboBox Header="Dispositivo de entrada (microfone)" 
                                              ItemsSource="{x:Bind ViewModel.AvailableMicrophones}" 
                                              SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="naudio:MMDevice">
                                                <TextBlock Text="{x:Bind FriendlyName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Grid ColumnDefinitions="Auto, *" Margin="0,2,0,0">
                                        <TextBlock Text="Volume de entrada:" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Slider Grid.Column="1" 
                                                Value="{x:Bind ViewModel.InputVolume, Mode=TwoWay}" 
                                                Minimum="0" 
                                                Maximum="200" 
                                                StepFrequency="1" 
                                                HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <ComboBox Header="Dispositivo de saída (fones / alto-falantes)" 
                                              ItemsSource="{x:Bind ViewModel.AvailableOutputDevices}" 
                                              SelectedItem="{x:Bind ViewModel.SelectedOutputDevice, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="naudio:MMDevice">
                                                <TextBlock Text="{x:Bind FriendlyName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Grid ColumnDefinitions="Auto, *" Margin="0,2,0,0">
                                        <TextBlock Text="Volume de saída:" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Slider Grid.Column="1" 
                                                Value="{x:Bind ViewModel.OutputVolume, Mode=TwoWay}" 
                                                Minimum="0" 
                                                Maximum="100" 
                                                StepFrequency="1" 
                                                HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <ToggleSwitch Header="Supressão de ruído" 
                                                  IsOn="{x:Bind ViewModel.EnableNoiseSuppression, Mode=TwoWay}" 
                                                  OnContent="Ativada" 
                                                  OffContent="Desativada"/>

                                    <StackPanel Spacing="8" Margin="0,4,0,0">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <TextBlock Text="Sensibilidade do microfone:" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Slider Grid.Column="1" 
                                                    Value="{x:Bind ViewModel.GateSensitivity, Mode=TwoWay}" 
                                                    IsEnabled="{x:Bind ViewModel.EnableNoiseSuppression, Mode=OneWay}"
                                                    Minimum="0" 
                                                    Maximum="100" 
                                                    StepFrequency="1" 
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto, *">
                                            <TextBlock Text="Intensidade do corte de ruído:" FontSize="12" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Slider Grid.Column="1" 
                                                    Value="{x:Bind ViewModel.NoiseSuppressionLevel, Mode=TwoWay}" 
                                                    IsEnabled="{x:Bind ViewModel.EnableNoiseSuppression, Mode=OneWay}"
                                                    Minimum="0" 
                                                    Maximum="100" 
                                                    StepFrequency="1" 
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <Button Content="{x:Bind ViewModel.TestMicButtonText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ToggleTestMicCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsNotInCall, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        Height="38" 
                                        CornerRadius="6"/>

                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Text="Nível:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" Opacity="0.8"/>

                                        <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                                            <Border Background="#25808080" CornerRadius="3" />
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{x:Bind ViewModel.VoiceFillGridLength, Mode=OneWay}" />
                                                    <ColumnDefinition Width="{x:Bind ViewModel.VoiceEmptyGridLength, Mode=OneWay}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#22C55E" CornerRadius="3" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Rede e portas" FontSize="15" FontWeight="SemiBold"/>
                                <TextBox Header="Minha porta local UDP" Text="{x:Bind ViewModel.LocalPort, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Aplicação" FontSize="15" FontWeight="SemiBold"/>

                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Elos" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Comunicação por voz peer-to-peer nativa" FontSize="12" Opacity="0.6"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" 
                                               Text="v0.0.1" 
                                               FontSize="12" 
                                               Opacity="0.6" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </NavigationView>

        <!-- Overlay Fullscreen para Transmissão de Tela -->
        <Grid x:Name="FullscreenOverlay"
              Grid.Row="0"
              Grid.RowSpan="2"
              Background="#1A1A1A"
              Visibility="{x:Bind ViewModel.IsScreenShareFullscreen, Mode=OneWay}">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Área do Player de Vídeo em Fullscreen -->
            <Border Grid.Row="0" Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Image Source="{x:Bind ViewModel.RemoteScreenImage, Mode=OneWay}" Stretch="Uniform"/>
            </Border>

            <!-- Barra de Controles Fullscreen -->
            <Border Grid.Row="1"
                    Background="#2A2A2A"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#404040"
                    Padding="20">
                <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, *, Auto">

                    <!-- Controle de Volume -->
                    <StackPanel Orientation="Vertical" Spacing="3" VerticalAlignment="Center" Width="180">
                        <TextBlock Text="Volume" 
                                   FontSize="12" 
                                   Opacity="0.8" 
                                   HorizontalAlignment="Left"/>

                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <Slider Grid.Column="0"
                                    Value="{x:Bind ViewModel.StreamVolume, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="200"
                                    StepFrequency="1"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.StreamVolumeText, Mode=OneWay}" 
                                       FontSize="11" 
                                       Foreground="#A8A8A8"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       Width="36"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Separador -->
                    <Border Grid.Column="1" Width="1" Margin="12,0" Background="#404040"/>

                    <!-- Botão Silenciar Microfone -->
                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.ToggleMuteCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind ViewModel.MuteToolTip, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.MuteGlyph, Mode=OneWay}" FontSize="14" Foreground="#E8E8E8"/>
                    </Button>

                    <!-- Botão Desativar Som -->
                    <Button Grid.Column="3"
                            Command="{x:Bind ViewModel.ToggleDeafenCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DeafenToolTip, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.DeafenGlyph, Mode=OneWay}" FontSize="14" Foreground="#E8E8E8"/>
                    </Button>

                    <!-- Botão Sair da Chamada -->
                    <Button Grid.Column="4"
                            Command="{x:Bind ViewModel.LeaveCallCommand}"
                            Background="#DC2626"
                            BorderThickness="0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Sair da chamada">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE778;" FontSize="14" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Espaçador -->
                    <Border Grid.Column="5"/>

                    <!-- Botão Sair do Fullscreen -->
                    <Button Grid.Column="6"
                            Command="{x:Bind ViewModel.ToggleScreenShareFullscreenCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Sair da tela cheia">
                        <FontIcon Glyph="&#xE73F;" FontSize="14" Foreground="#E8E8E8"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Diálogo Estilo Discord para Seleção de Janela / Tela e Opções -->
        <ContentDialog x:Name="ScreenShareDialog"
                       Title="Compartilhar sua tela"
                       PrimaryButtonText="Transmitir ao vivo"
                       CloseButtonText="Cancelar"
                       DefaultButton="Primary">
            <StackPanel Spacing="16" Width="380">
                <!-- Seletor de Janela ou Tela Inteira -->
                <ComboBox Header="O que você quer compartilhar?"
                          ItemsSource="{x:Bind ViewModel.AvailableCaptureTargets}"
                          SelectedItem="{x:Bind ViewModel.SelectedCaptureTarget, Mode=TwoWay}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:CaptureTargetItem">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind DisplaySubtitle}" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Qualidade da transmissão -->
                <ComboBox Header="Qualidade da transmissão"
                          ItemsSource="{x:Bind ViewModel.AvailableQualities}"
                          SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ScreenShareQuality">
                            <TextBlock Text="{x:Bind Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Compartilhar som -->
                <ToggleSwitch Header="Compartilhar áudio do sistema"
                              IsOn="{x:Bind ViewModel.ShareScreenAudio, Mode=TwoWay}"
                              OnContent="Sim"
                              OffContent="Não"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>